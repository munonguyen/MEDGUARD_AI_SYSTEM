+  font-weight: 600;
+  color: var(--spend-text-muted);
+}
+
+.preset-pill {
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid var(--spend-border);
+  color: var(--spend-text-secondary);
+  font-size: 0.78rem;
+  font-weight: 600;
+  padding: 4px 10px;
+  border-radius: 8px;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.preset-pill:hover {
+  background: rgba(0, 229, 255, 0.15);
+  color: #ffffff;
+  border-color: var(--spend-cyan);
+}
+
+.preset-pill.active {
+  background: rgba(0, 229, 255, 0.25);
+  color: #00e5ff;
+  border-color: #00e5ff;
+  font-weight: 700;
+}
+
+@media (max-width: 992px) {
+  .budget-hero-card {
+    grid-template-columns: 1fr;
+  }
+  .budget-hero-left {
+    border-right: none;
+    border-bottom: 1px solid var(--spend-border-subtle);
+    padding-right: 0;
+    padding-bottom: 16px;
+  }
+  .allocation-items-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
