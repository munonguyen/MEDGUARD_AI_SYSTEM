MEDGUARD_ENVIRONMENT=production
MEDGUARD_DATABASE_URL=postgresql://medguard_app:replace-me@postgres:5432/medguard
MEDGUARD_MIGRATION_DATABASE_URL=postgresql://medguard_admin:replace-me@postgres:5432/medguard
MEDGUARD_DB_POOL_SIZE=10
MEDGUARD_DB_MAX_OVERFLOW=20
MEDGUARD_DB_CONNECT_TIMEOUT_SECONDS=5
MEDGUARD_REDIS_URL=redis://redis:6379/0
MEDGUARD_QUEUE_MAX_ATTEMPTS=3
MEDGUARD_S3_ENDPOINT=https://object-storage.example.internal
MEDGUARD_S3_BUCKET=medguard-prescriptions
MEDGUARD_S3_ACCESS_KEY=replace-me
MEDGUARD_S3_SECRET_KEY=replace-me
MEDGUARD_ALLOWED_TENANTS=hospital-a
MEDGUARD_API_KEYS_JSON={"hospital-a":"replace-with-random-api-key"}
MEDGUARD_DELIVERY_HMAC_SECRET=replace-with-random-hmac-secret
MEDGUARD_SECRET_MASTER_KEY=replace-with-random-master-key
MEDGUARD_RATE_LIMIT_ENABLED=true
MEDGUARD_RATE_LIMIT_REQUESTS=120
MEDGUARD_RATE_LIMIT_WINDOW_SECONDS=60
MEDGUARD_ENFORCE_CONSENT=true
MEDGUARD_LOG_LEVEL=INFO
# Production promotion target. Run a deidentified shadow evaluation before enabling this value.
MEDGUARD_AGENT_MODE=enforced
MEDGUARD_AGENT_COVERAGE_SCOPE=all
MEDGUARD_RESEARCH_AGENT_PROVIDER=litellm
MEDGUARD_VERIFIER_AGENT_PROVIDER=litellm
MEDGUARD_AGENT_REQUIRED_FOR_PRODUCTION=true
MEDGUARD_AGENT_SYNC_ENABLED=false
MEDGUARD_AGENT_BACKGROUND_ENABLED=false
MEDGUARD_AGENT_BACKGROUND_MAX_PENDING=100
MEDGUARD_AGENT_BACKGROUND_WORKERS=1
MEDGUARD_AGENT_BACKGROUND_MAX_ATTEMPTS=3
MEDGUARD_AGENT_BACKGROUND_RETRY_BASE_SECONDS=0.5
MEDGUARD_AGENT_BACKGROUND_GATEWAY_WAIT_SECONDS=180
MEDGUARD_AGENT_BACKGROUND_STAGE_TIMEOUT_SECONDS=120
MEDGUARD_AGENT_BACKGROUND_TOTAL_TIMEOUT_SECONDS=240
MEDGUARD_AGENT_BACKGROUND_RESEARCH_MAX_OUTPUT_TOKENS=1200
MEDGUARD_AGENT_BACKGROUND_VERIFIER_MAX_OUTPUT_TOKENS=500
MEDGUARD_AGENT_BACKGROUND_PROMOTE_VERIFIED=false
MEDGUARD_LLM_GATEWAY_URL=http://litellm:4000/v1
MEDGUARD_LLM_GATEWAY_API_KEY=replace-with-litellm-virtual-key
MEDGUARD_LLM_GATEWAY_HEALTH_TIMEOUT_SECONDS=2
MEDGUARD_LLM_GATEWAY_API_STYLE=responses
MEDGUARD_RESEARCH_AGENT_MODEL=medguard-answer
MEDGUARD_VERIFIER_AGENT_MODEL=medguard-verifier
MEDGUARD_RESEARCH_REASONING_EFFORT=none
MEDGUARD_VERIFIER_REASONING_EFFORT=none
MEDGUARD_AGENT_TIMEOUT_SECONDS=4
MEDGUARD_AGENT_TOTAL_TIMEOUT_SECONDS=8
MEDGUARD_AGENT_WEB_SEARCH_ENABLED=false
MEDGUARD_AGENT_WEB_SEARCH_REQUIRED=false
MEDGUARD_VERIFIER_WEB_SEARCH_ENABLED=false
MEDGUARD_VERIFIER_WEB_SEARCH_REQUIRED=false
MEDGUARD_AGENT_MAX_INPUT_TOKENS=12000
MEDGUARD_RESEARCH_MAX_OUTPUT_TOKENS=700
MEDGUARD_VERIFIER_MAX_OUTPUT_TOKENS=300
MEDGUARD_AGENT_PROMPT_VERSION=2026-09-09
MEDGUARD_SAFE_CACHE_TTL_SECONDS=300
MEDGUARD_LLM_SINGLEFLIGHT_TIMEOUT_SECONDS=50
MEDGUARD_VERIFIER_MIN_GROUNDING=0.90
MEDGUARD_VERIFIER_MIN_SAFETY=0.95
MEDGUARD_VERIFIER_MIN_COMPLETENESS=0.85
MEDGUARD_VERIFIER_MIN_CITATION_COVERAGE=0.90
