LITELLM_ENVIRONMENT=development
LITELLM_MASTER_KEY=replace-with-random-master-key
LITELLM_DB_PASSWORD=replace-with-random-database-password
REDIS_PASSWORD=replace-with-random-redis-password
# Default: local Ollama only. Other available profiles:
#   ./config.gemini-free.yaml = Gemini 2.5 Flash grounded writer + local MedGemma 1.5 4B judge
#   ./config.yaml             = Gemini analyzer + paid OpenAI judge
LITELLM_CONFIG_FILE=./config.ollama.yaml
GEMINI_API_KEY=
OPENAI_API_KEY=
