LITELLM_ENVIRONMENT=development
LITELLM_MASTER_KEY=replace-with-random-master-key
LITELLM_DB_PASSWORD=replace-with-random-database-password
REDIS_PASSWORD=replace-with-random-redis-password

# High-quality free development profile:
#   Writer   -> Gemini 3.8 Flash
#   Reviewer -> Gemini 3.5 Flash-Lite
# Both use Gemini Developer API free tier subject to current Google quotas.
# Use de-identified test/dev data only.
LITELLM_CONFIG_FILE=./config.gemini-free.yaml

# Create a Gemini API key in Google AI Studio and place it ONLY in the local
# infrastructure/litellm/.env file. Never commit a real key.
GEMINI_API_KEY=

# Optional paid profile only; not required by config.gemini-free.yaml.
OPENAI_API_KEY=
