+
+export function getMapLibreStyleForTheme(theme) {
+  if (theme === 'satellite') return SATELLITE_RASTER_STYLE;
+  if (theme === 'dark') return DARK_RASTER_STYLE;
+  if (theme === 'osm') return OSM_RASTER_STYLE;
