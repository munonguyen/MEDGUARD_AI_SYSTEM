+    if "arrive" in t.lower():
+        return f"Bạn đã đến nơi: {road or 'Quầy thuốc GPP'}."
+
+    m_round = re.search(r"take the (\d+)(?:st|nd|rd|th)? exit onto (.+)", t, re.IGNORECASE)
+    if m_round:
