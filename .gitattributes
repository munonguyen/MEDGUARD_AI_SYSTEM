# Generated same-origin frontend bundles are reviewed through their source files.
app/static/app.js linguist-generated=true
app/static/style.css linguist-generated=true
app/static/assets/** linguist-generated=true -diff

# Keep repository text files normalized across development platforms.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
