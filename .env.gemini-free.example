# MedGuard application profile: fast deterministic first response, then
# background Gemini Search + local MedGemma verification and safe promotion.
# Copy the relevant values into .env; do not commit real keys.
MEDGUARD_AGENT_MODE=shadow
MEDGUARD_AGENT_COVERAGE_SCOPE=all
MEDGUARD_AGENT_SYNC_ENABLED=false
MEDGUARD_AGENT_BACKGROUND_ENABLED=true
MEDGUARD_AGENT_BACKGROUND_PROMOTE_VERIFIED=true
MEDGUARD_AGENT_BACKGROUND_WORKERS=1
MEDGUARD_AGENT_BACKGROUND_MAX_PENDING=100
MEDGUARD_AGENT_BACKGROUND_MAX_ATTEMPTS=3
MEDGUARD_AGENT_BACKGROUND_RETRY_BASE_SECONDS=0.5
MEDGUARD_AGENT_BACKGROUND_GATEWAY_WAIT_SECONDS=180
MEDGUARD_AGENT_BACKGROUND_STAGE_TIMEOUT_SECONDS=180
MEDGUARD_AGENT_BACKGROUND_TOTAL_TIMEOUT_SECONDS=240
MEDGUARD_AGENT_BACKGROUND_RESEARCH_MAX_OUTPUT_TOKENS=1400
MEDGUARD_AGENT_BACKGROUND_VERIFIER_MAX_OUTPUT_TOKENS=700

MEDGUARD_LLM_GATEWAY_URL=http://127.0.0.1:4000/v1
MEDGUARD_LLM_GATEWAY_API_KEY=replace-with-the-same-random-master-key-as-litellm
MEDGUARD_LLM_GATEWAY_API_STYLE=chat_completions

# Writer uses Gemini's hosted Google Search. Reviewer is local and receives
# allow-listed source page text fetched by MedGuard's bounded evidence fetcher.
MEDGUARD_AGENT_WEB_SEARCH_ENABLED=true
MEDGUARD_AGENT_WEB_SEARCH_REQUIRED=true
MEDGUARD_VERIFIER_WEB_SEARCH_ENABLED=false
MEDGUARD_VERIFIER_WEB_SEARCH_REQUIRED=false
MEDGUARD_RESEARCH_REASONING_EFFORT=none
MEDGUARD_VERIFIER_REASONING_EFFORT=none
MEDGUARD_AGENT_MAX_ITERATIONS=0

# Never put GEMINI_API_KEY in this application .env. It belongs only in
# infrastructure/litellm/.env so all provider calls remain gateway-mediated.
