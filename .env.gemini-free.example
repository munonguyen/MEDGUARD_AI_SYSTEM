# MedGuard application profile: synchronous V27.1 Writer -> Reviewer -> Jev
# using the stable free Gemini gateway profile.
#
# IMPORTANT: use de-identified development/test data only. Gemini free-tier
# inputs may be used by Google to improve its products. Do not put a real
# GEMINI_API_KEY in this application .env; keep it in infrastructure/litellm/.env.

MEDGUARD_ENVIRONMENT=development
MEDGUARD_AGENT_MODE=enforced
MEDGUARD_AGENT_COVERAGE_SCOPE=all
MEDGUARD_AGENT_SYNC_ENABLED=true
MEDGUARD_AGENT_BACKGROUND_ENABLED=false
MEDGUARD_AGENT_BACKGROUND_PROMOTE_VERIFIED=false

# Application -> LiteLLM gateway
MEDGUARD_LLM_GATEWAY_URL=http://127.0.0.1:4000/v1
MEDGUARD_LLM_GATEWAY_API_KEY=replace-with-the-same-random-master-key-as-litellm
MEDGUARD_LLM_GATEWAY_API_STYLE=chat_completions

# Default FREE model mapping:
#   Writer aliases   -> Gemini 3.5 Flash-Lite
#   Reviewer aliases -> Gemini 3.5 Flash-Lite
# Live free-tier testing showed both Gemini 3.8 Flash and Gemini 3.5 Flash can
# hit a 20 requests/day per-model ceiling on the tested project, so neither is
# suitable as the mandatory patient-visible Writer path for repeated traffic.
# The quota-backed quality profile keeps the stronger model split separately.
MEDGUARD_RESEARCH_AGENT_MODEL=medguard-answer
MEDGUARD_VERIFIER_AGENT_MODEL=medguard-verifier
MEDGUARD_CLINICAL_RESEARCH_MODEL=medguard-clinical-answer
MEDGUARD_CLINICAL_VERIFIER_MODEL=medguard-clinical-verifier
MEDGUARD_PHARMA_RESEARCH_MODEL=medguard-pharma-answer
MEDGUARD_PHARMA_VERIFIER_MODEL=medguard-pharma-verifier

# Free-profile reliability: grounding comes from MedGuard KB/RAG/runtime evidence.
# Hosted search is not required, preventing search quota/tool availability from
# forcing the response into deterministic fallback.
MEDGUARD_AGENT_WEB_SEARCH_ENABLED=false
MEDGUARD_AGENT_WEB_SEARCH_REQUIRED=false
MEDGUARD_VERIFIER_WEB_SEARCH_ENABLED=false
MEDGUARD_VERIFIER_WEB_SEARCH_REQUIRED=false

# Keep Writer and Reviewer role instructions different even though the FREE
# profile uses the same provider model for quota stability.
MEDGUARD_RESEARCH_REASONING_EFFORT=high
MEDGUARD_VERIFIER_REASONING_EFFORT=medium
MEDGUARD_AGENT_MAX_ITERATIONS=1

# Free API calls can be slower than local deterministic logic. These values keep
# the patient-visible agent path alive long enough to complete one revision pass.
MEDGUARD_AGENT_TIMEOUT_SECONDS=30
MEDGUARD_AGENT_TOTAL_TIMEOUT_SECONDS=60
MEDGUARD_RESEARCH_MAX_OUTPUT_TOKENS=3000
MEDGUARD_VERIFIER_MAX_OUTPUT_TOKENS=450
MEDGUARD_AGENT_MAX_INPUT_TOKENS=12000

# Keep existing deterministic safety/quality thresholds authoritative.
MEDGUARD_VERIFIER_MIN_GROUNDING=0.90
MEDGUARD_VERIFIER_MIN_SAFETY=0.95
MEDGUARD_VERIFIER_MIN_COMPLETENESS=0.85
MEDGUARD_VERIFIER_MIN_CITATION_COVERAGE=0.90

# Gateway cache / single-flight remain available for repeated safe requests.
MEDGUARD_SAFE_CACHE_TTL_SECONDS=300
MEDGUARD_LLM_SINGLEFLIGHT_TIMEOUT_SECONDS=50
