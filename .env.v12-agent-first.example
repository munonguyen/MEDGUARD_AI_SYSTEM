# MedGuard V12 agent-first clinical development profile.
# Copy the relevant values into your untracked .env. Do not commit real keys.
#
# Normal answered TRIAGE/SAFETY requests use the Writer -> Reviewer pipeline as
# the primary patient-facing response path. Deterministic clinical logic still
# owns safety floors, red flags and locked emergency actions. If the gateway is
# unavailable or verification fails, MedGuard falls back to its safe bounded
# deterministic response.

MEDGUARD_ENVIRONMENT=development
MEDGUARD_AGENT_MODE=enforced
MEDGUARD_AGENT_COVERAGE_SCOPE=clinical
MEDGUARD_AGENT_SYNC_ENABLED=false
MEDGUARD_AGENT_BACKGROUND_ENABLED=false
MEDGUARD_AGENT_MAX_ITERATIONS=1

# LiteLLM remains the only model network boundary.
MEDGUARD_LLM_GATEWAY_URL=http://127.0.0.1:4000/v1
MEDGUARD_LLM_GATEWAY_API_KEY=replace-with-the-same-virtual-key-issued-by-litellm
MEDGUARD_LLM_GATEWAY_API_STYLE=chat_completions

# Writer / independent reviewer model aliases are resolved by LiteLLM.
MEDGUARD_RESEARCH_AGENT_MODEL=medguard-answer
MEDGUARD_VERIFIER_AGENT_MODEL=medguard-verifier
MEDGUARD_CLINICAL_RESEARCH_MODEL=medguard-clinical-answer
MEDGUARD_CLINICAL_VERIFIER_MODEL=medguard-clinical-verifier
MEDGUARD_PHARMA_RESEARCH_MODEL=medguard-pharma-answer
MEDGUARD_PHARMA_VERIFIER_MODEL=medguard-pharma-verifier

# Keep the whole Writer -> Reviewer -> optional single revision inside the
# existing chat SLO. A timeout degrades to the deterministic safe fallback.
MEDGUARD_AGENT_TIMEOUT_SECONDS=4
MEDGUARD_AGENT_TOTAL_TIMEOUT_SECONDS=8
MEDGUARD_RESEARCH_MAX_OUTPUT_TOKENS=700
MEDGUARD_VERIFIER_MAX_OUTPUT_TOKENS=300

# Evidence policy. Change these only when the selected gateway profile supports
# the corresponding search/reviewer evidence contract.
MEDGUARD_AGENT_WEB_SEARCH_ENABLED=true
MEDGUARD_AGENT_WEB_SEARCH_REQUIRED=true
MEDGUARD_VERIFIER_WEB_SEARCH_ENABLED=true
MEDGUARD_VERIFIER_WEB_SEARCH_REQUIRED=true
MEDGUARD_VERIFIER_MIN_GROUNDING=0.90
MEDGUARD_VERIFIER_MIN_SAFETY=0.95
MEDGUARD_VERIFIER_MIN_COMPLETENESS=0.85
MEDGUARD_VERIFIER_MIN_CITATION_COVERAGE=0.90
