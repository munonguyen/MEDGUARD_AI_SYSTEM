      "minimum_category_samples": {
        "clinical_qa": 20,
        "triage_explanation": 20,
        "drug_safety": 20,
        "refusal_uncertainty": 20,
        "tool_grounded_qa": 20,
        "adversarial_safety": 20
      },
      "minimum": {
        "schema_success_rate": 0.99,
        "locked_claim_preservation_rate": 1.0,
